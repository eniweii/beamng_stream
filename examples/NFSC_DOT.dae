<?xml version="1.0" encoding="utf-8"?>
<COLLADA xmlns="http://www.collada.org/2005/11/COLLADASchema" version="1.4.1">
  <asset>
    <contributor><authoring_tool>beamng_stream</authoring_tool></contributor>
    <unit name="meter" meter="1"/>
    <up_axis>Z_UP</up_axis>
  </asset>
  <library_effects>
    <effect id="nfsc_dot-effect">
      <profile_COMMON>
        <technique sid="common">
          <lambert>
            <diffuse><color sid="diffuse">0.5 0.5 0.5 1</color></diffuse>
          </lambert>
        </technique>
      </profile_COMMON>
    </effect>
  </library_effects>
  <library_materials>
    <material id="nfsc_dot-material" name="nfsc_dot">
      <instance_effect url="#nfsc_dot-effect"/>
    </material>
  </library_materials>
  <library_geometries>
    <geometry id="nfsc_dot-mesh" name="nfsc_dot">
      <mesh>
        <source id="nfsc_dot-positions">
          <float_array id="nfsc_dot-positions-array" count="12">-0.005 -0.005 0 0.005 -0.005 0 0.005 0.005 0 -0.005 0.005 0</float_array>
          <technique_common>
            <accessor source="#nfsc_dot-positions-array" count="4" stride="3">
              <param name="X" type="float"/><param name="Y" type="float"/><param name="Z" type="float"/>
            </accessor>
          </technique_common>
        </source>
        <source id="nfsc_dot-normals">
          <float_array id="nfsc_dot-normals-array" count="3">0 0 1</float_array>
          <technique_common>
            <accessor source="#nfsc_dot-normals-array" count="1" stride="3">
              <param name="X" type="float"/><param name="Y" type="float"/><param name="Z" type="float"/>
            </accessor>
          </technique_common>
        </source>
        <source id="nfsc_dot-map">
          <float_array id="nfsc_dot-map-array" count="8">0 0 1 0 1 1 0 1</float_array>
          <technique_common>
            <accessor source="#nfsc_dot-map-array" count="4" stride="2">
              <param name="S" type="float"/><param name="T" type="float"/>
            </accessor>
          </technique_common>
        </source>
        <vertices id="nfsc_dot-vertices">
          <input semantic="POSITION" source="#nfsc_dot-positions"/>
        </vertices>
        <triangles material="nfsc_dot-material" count="2">
          <input semantic="VERTEX" source="#nfsc_dot-vertices" offset="0"/>
          <input semantic="NORMAL" source="#nfsc_dot-normals" offset="1"/>
          <input semantic="TEXCOORD" source="#nfsc_dot-map" offset="2" set="0"/>
          <p>0 0 0 1 0 1 2 0 2 0 0 0 2 0 2 3 0 3</p>
        </triangles>
      </mesh>
    </geometry>
  </library_geometries>
  <library_visual_scenes>
    <visual_scene id="Scene" name="Scene">
      <node id="nfsc_dot" name="nfsc_dot" type="NODE">
        <instance_geometry url="#nfsc_dot-mesh" name="nfsc_dot">
          <bind_material>
            <technique_common>
              <instance_material symbol="nfsc_dot-material" target="#nfsc_dot-material"/>
            </technique_common>
          </bind_material>
        </instance_geometry>
      </node>
    </visual_scene>
  </library_visual_scenes>
  <scene><instance_visual_scene url="#Scene"/></scene>
</COLLADA>
